# =============================================================
# Hiring Intent Intelligence Platform — Environment Variables
# =============================================================
# Copy this file to:
#   backend/.env        → for the backend API + worker
#   frontend/.env.local → for the Next.js frontend
# Then fill in your actual values.
# =============================================================

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/jobtool

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Apify ───────────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_...
APIFY_ACTOR_ID=2rJKkhh7vjpX7pvjg
APIFY_MAX_ITEMS=150
# LinkedIn "posted within" window: r86400=24h, r604800=7d, r2592000=30d
APIFY_PUBLISHED_AT=r604800

# ─── Backend ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Country scraper (Python/Playwright) ─────────────────────
# Path to the python binary, relative to backend/scraper/
SCRAPER_PYTHON=venv/bin/python3
COUNTRY_SCRAPE_CONCURRENCY=2
COUNTRY_SCRAPE_TIMEOUT_MS=180000

# ─── Scheduler ───────────────────────────────────────────────
# How often the scheduler checks for due keyword×source runs (cron pattern)
SCHEDULER_CRON_PATTERN=*/15 * * * *
SOURCE_FETCH_CONCURRENCY=1

# ─── Company intelligence & scoring ──────────────────────────
COMPANY_INTEL_CONCURRENCY=2
# Debounce window for company recalculation (ms)
RECALC_DEBOUNCE_MS=600000
# Canonical jobs unseen for this many days become INACTIVE
JOB_STALE_DAYS=14
# Opportunity score weights (should sum to 100)
SCORE_WEIGHT_RELEVANCE=60
SCORE_WEIGHT_VOLUME=10
SCORE_WEIGHT_VELOCITY=10
SCORE_WEIGHT_OUTSOURCING=20
# Jobs below this AI relevance (0-100) never count toward company metrics/scores
MIN_JOB_RELEVANCE=40

# ─── Description enrichment (fetches full job descriptions) ──
# Off by default — spawns a Chromium browser and adds memory pressure.
# Set to "true" only on an instance with ≥1GB RAM.
DESC_ENRICH_ENABLED=false
DESC_ENRICH_CONCURRENCY=1
DESC_ENRICH_BATCH=8
DESC_ENRICH_TIMEOUT_MS=300000

# ─── Frontend (add these to frontend/.env.local) ─────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Set to "true" to use demo data, "false" to hit real API
NEXT_PUBLIC_USE_DEMO_DATA=true
